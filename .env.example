# Database (required)
# Use the non-owner application role in deployed runtimes so RLS is enforced.
DATABASE_URL=postgresql://jobagent_app:replace-me@localhost:5432/jobagent
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters
# Owner/admin URL is for migrations, backup/restore, and controlled seed operations only.
DATABASE_ADMIN_URL=postgresql://jobagent_admin:replace-me@localhost:5432/jobagent
# Internal worker maintenance operations use this owner-scoped connection; never expose it to HTTP handlers.

# AI Provider (required for AI analysis and document generation)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o

# Security (required; use independent random secrets of at least 32 characters)
ENCRYPTION_KEY=
JWT_SECRET=

# App
PORT=3001
HTTP_SHUTDOWN_TIMEOUT_MS=30000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Redis/BullMQ coordination (required in production; use rediss:// for non-local Redis)
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=jobagent

# Private document storage (S3-compatible; required for uploads)
S3_DOCUMENT_BUCKET=jobagent-private-documents
S3_REGION=us-east-1
# Set for MinIO or another S3-compatible endpoint; leave empty for AWS S3.
S3_ENDPOINT=http://localhost:9000
# Optional customer-managed KMS key; S3-managed encryption is used when empty.
S3_KMS_KEY_ID=
# Required ClamAV-compatible scanner command, for example: clamscan
DOCUMENT_SCANNER_COMMAND=
# Optional HTTPS OTLP/HTTP traces endpoint. Production validates this endpoint before startup.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=jobagent-api
DOCUMENT_RETENTION_INTERVAL_MS=3600000

# Email OAuth authorization (provider client IDs only; tokens stay in the encrypted credential vault)
GMAIL_OAUTH_CLIENT_ID=
MICROSOFT_GRAPH_OAUTH_CLIENT_ID=
# Optional comma-separated HTTPS origins for OAuth callbacks; production falls back to FRONTEND_URL when empty.
OAUTH_ALLOWED_REDIRECT_ORIGINS=

# Worker runtime tuning (durable loops; values are bounded at startup)
SCHEDULER_INTERVAL_MS=60000
NOTIFICATION_OUTBOX_INTERVAL_MS=1000
NOTIFICATION_OUTBOX_BATCH_SIZE=50
WORKER_CONCURRENCY=4
WORKER_SHUTDOWN_TIMEOUT_MS=30000
