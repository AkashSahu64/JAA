# Database (required)
# Use the non-owner application role in deployed runtimes so RLS is enforced.
DATABASE_URL=postgresql://jobagent_app:replace-me@localhost:5432/jobagent
# Owner/admin URL is for migrations, backup/restore, and controlled seed operations only.
DATABASE_ADMIN_URL=postgresql://jobagent_admin:replace-me@localhost:5432/jobagent

# AI Provider (required for AI analysis and document generation)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o

# Security (required; use independent random secrets of at least 32 characters)
ENCRYPTION_KEY=
JWT_SECRET=

# App
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Private document storage (S3-compatible; required for uploads)
S3_DOCUMENT_BUCKET=jobagent-private-documents
S3_REGION=us-east-1
# Set for MinIO or another S3-compatible endpoint; leave empty for AWS S3.
S3_ENDPOINT=
# Optional customer-managed KMS key; S3-managed encryption is used when empty.
S3_KMS_KEY_ID=
# Required ClamAV-compatible scanner command, for example: clamscan
DOCUMENT_SCANNER_COMMAND=
